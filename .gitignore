# Node dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Production client builds
dist/
dist-ssr/
client/dist/

# Sensitive environment variables & secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
server/.env
*.env

# SQLite local databases and write-ahead logs
server/data/*.sqlite
server/data/*.sqlite-shm
server/data/*.sqlite-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal

# User-uploaded runtime media
server/uploads/*
!server/uploads/.gitkeep
server/data/*
!server/data/.gitkeep

# Executables & large binaries
cloudflared.exe
*.exe

# OS and Editor artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Temporary scratch logs
*.log
